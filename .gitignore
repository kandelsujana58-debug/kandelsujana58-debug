* {
  box-sizing: border-box;
}

:root {
  --bg: #060816;
  --bg-secondary: #0d1224;
  --panel: rgba(15, 20, 36, 0.7);
  --panel-strong: rgba(18, 24, 42, 0.9);
  --text: #edf3ff;
  --muted: #a4b0d6;
  --purple: #8b5cf6;
  --blue: #38bdf8;
  --cyan: #67e8f9;
  --border: rgba(164, 176, 214, 0.18);
  --shadow: 0 30px 80px rgba(5, 8, 18, 0.5);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(139, 92, 246, 0.18), transparent 30%),
    radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.18), transparent 35%),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.section-spacing {
  padding: 96px 0;
}

.bg-grid {
  position: fixed;
  inset: 0;
  background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(circle at center, black 15%, transparent 85%);
  pointer-events: none;
}

.bg-glow {
  position: fixed;
  width: 480px;
  height: 480px;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.3;
  pointer-events: none;
}

.glow-one {
  background: rgba(139, 92, 246, 0.42);
  top: 10%;
  left: -8%;
}

.glow-two {
  background: rgba(56, 189, 248, 0.28);
  bottom: 10%;
  right: -8%;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0 10px;
  backdrop-filter: blur(18px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--purple), var(--blue));
  box-shadow: 0 12px 30px rgba(139, 92, 246, 0.45);
}

.nav {
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 12px 18px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(11, 17, 30, 0.4);
}

.nav a {
  color: var(--muted);
  font-size: 0.92rem;
  transition: color 0.2s ease;
}

.nav a:hover,
.nav a:focus-visible {
  color: var(--text);
}

.nav-cta,
.primary-btn,
.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.nav-cta,
.primary-btn {
  padding: 0.88rem 1.4rem;
  background: linear-gradient(135deg, var(--purple), var(--blue));
  box-shadow: 0 20px 45px rgba(83, 92, 255, 0.4);
}

.secondary-btn {
  padding: 0.88rem 1.4rem;
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.04);
}

.nav-cta:hover,
.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-2px);
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 34px;
  padding-top: 68px;
}

.eyebrow {
  margin: 0 0 14px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--cyan);
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.hero-copy h1 span {
  background: linear-gradient(135deg, var(--purple), var(--blue), var(--cyan));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.lead {
  max-width: 620px;
  margin-top: 22px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.8;
}

.cta-row {
  display: flex;
  gap: 16px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.quick-stats {
  list-style: none;
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  padding: 0;
  margin: 38px 0 0;
}

.quick-stats li {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 120px;
}

.quick-stats strong {
  font-size: 1.5rem;
}

.quick-stats span {
  color: var(--muted);
  font-size: 0.82rem;
}

.hero-visual {
  display: grid;
  place-items: center;
  perspective: 1400px;
}

.glass-panel {
  background: rgba(16, 22, 38, 0.76);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
}

.orb-card {
  position: relative;
  width: min(480px, 90vw);
  min-height: 420px;
  border-radius: 32px;
  padding: 22px 24px 30px;
  transform: rotateX(12deg) rotateY(-14deg);
  animation: float 8s ease-in-out infinite;
}

.orb-header {
  display: flex;
  gap: 10px;
  align-items: center;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: inline-block;
}

.dot.red { background: #ff6b6b; }
.dot.yellow { background: #ffd93d; }
.dot.green { background: #6ee7b7; }

.orb-body {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 260px;
  overflow: hidden;
}

.orb-core {
  position: relative;
  width: 176px;
  height: 176px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #f0f4ff, #7c3aed 42%, #1c133b 100%);
  box-shadow: 0 0 60px rgba(124, 58, 237, 0.55), inset 0 0 22px rgba(255, 255, 255, 0.4);
}

.orb-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.18);
}

.ring-one {
  width: 260px;
  height: 260px;
  transform: rotateX(67deg);
}

.ring-two {
  width: 310px;
  height: 310px;
  border-color: rgba(56, 189, 248, 0.4);
  transform: rotateY(68deg);
}

.orb-labels {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.orb-labels span {
  display: inline-block;
  padding: 0.6rem 0.9rem;
  border-radius: 999px;
  border: 1px solid rgba(164, 176, 214, 0.15);
  background: rgba(255, 255, 255, 0.02);
  color: var(--muted);
  font-size: 0.76rem;
}

.section-heading {
  margin-bottom: 26px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 2.5vw, 3rem);
  letter-spacing: -0.05em;
}

.about-grid,
.contact-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 22px;
}

.about-card,
.mini-stats,
.project-card,
.timeline-item,
.contact-card,
.form-card {
  border-radius: 28px;
  padding: 28px;
}

.about-card p {
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.9;
  margin: 0 0 18px;
}

.about-card p:last-child {
  margin-bottom: 0;
}

.mini-stats {
  display: grid;
  gap: 22px;
}

.mini-stats div {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border);
}

.mini-stats div:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.mini-stats span {
  color: var(--muted);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.mini-stats strong {
  font-size: 1.1rem;
}

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.skill-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148px;
  padding: 1rem 1.3rem;
  border-radius: 14px;
  color: var(--text);
  font-weight: 600;
  animation: rise 0.7s ease both;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.project-card {
  position: relative;
  overflow: hidden;
  min-height: 280px;
}

.project-card::before {
  content: '';
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 100%;
  opacity: 0.08;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.8), rgba(56, 189, 248, 0.8));
}

.project-card > * {
  position: relative;
  z-index: 1;
}

.project-card.purple::before { background: linear-gradient(135deg, rgba(139, 92, 246, 0.8), rgba(167, 139, 250, 0.3)); }
.project-card.blue::before { background: linear-gradient(135deg, rgba(59, 130, 246, 0.8), rgba(56, 189, 248, 0.3)); }
.project-card.cyan::before { background: linear-gradient(135deg, rgba(6, 182, 212, 0.8), rgba(99, 102, 241, 0.3)); }

.project-badge {
  display: inline-block;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.project-card h3 {
  margin: 20px 0 12px;
  font-size: 1.7rem;
  letter-spacing: -0.04em;
}

.project-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.stack-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 22px;
}

.stack-row span {
  padding: 0.52rem 0.74rem;
  border: 1px solid rgba(168, 180, 220, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  font-size: 0.8rem;
}

.timeline {
  display: grid;
  gap: 18px;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 18px 1fr;
  align-items: flex-start;
  gap: 18px;
}

.timeline-dot {
  width: 14px;
  height: 14px;
  margin-top: 12px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--purple), var(--blue));
  box-shadow: 0 0 18px rgba(139, 92, 246, 0.6);
}

.timeline-content {
  width: 100%;
}

.timeline-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 6px;
}

.timeline-topline h3 {
  margin: 0;
  font-size: 1.3rem;
}

.timeline-topline span,
.company-name {
  color: var(--muted);
}

.timeline-content p {
  margin: 10px 0 0;
  color: var(--muted);
  line-height: 1.8;
}

.contact-card h3 {
  margin-top: 0;
  font-size: 1.5rem;
}

.contact-links {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 22px;
}

.contact-links a {
  color: var(--text);
  padding: 0.8rem 1rem;
  border-radius: 12px;
  border: 1px solid rgba(164, 176, 214, 0.15);
  background: rgba(255, 255, 255, 0.02);
}

.form-card {
  display: grid;
  gap: 20px;
}

.form-card label {
  display: grid;
  gap: 9px;
  color: var(--muted);
  font-size: 0.92rem;
}

.form-card input,
.form-card textarea {
  width: 100%;
  border-radius: 14px;
  border: 1px solid rgba(164, 176, 214, 0.14);
  background: rgba(7, 12, 23, 0.8);
  color: var(--text);
  padding: 0.92rem 1rem;
  resize: vertical;
}

.form-card input:focus,
.form-card textarea:focus {
  outline: 2px solid rgba(56, 189, 248, 0.5);
  border-color: rgba(56, 189, 248, 0.5);
}

.submit-btn {
  width: fit-content;
  border: 0;
  cursor: pointer;
}

@keyframes float {
  0%, 100% { transform: rotateX(12deg) rotateY(-14deg) translateY(0px); }
  50% { transform: rotateX(14deg) rotateY(-8deg) translateY(-16px); }
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .topbar {
    flex-wrap: wrap;
    gap: 18px;
    justify-content: center;
  }

  .nav {
    order: 3;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero,
  .about-grid,
  .contact-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 36px;
  }
}

@media (max-width: 600px) {
  .section-spacing {
    padding: 72px 0;
  }

  .topbar {
    padding-top: 14px;
  }

  .brand {
    font-size: 0.96rem;
  }

  .nav {
    gap: 14px 18px;
    padding: 12px 16px;
  }

  .nav a {
    font-size: 0.82rem;
  }

  .nav-cta {
    display: none;
  }

  .cta-row {
    flex-direction: column;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }

  .quick-stats {
    gap: 18px;
  }

  .orb-card {
    min-height: 360px;
  }

  .timeline-item {
    grid-template-columns: 12px 1fr;
  }

  .timeline-topline {
    flex-direction: column;
    align-items: flex-start;
  }
}
